# Copy to ~/.config/ui-design-loop/.env (every project) or <project>/.ui-design-loop.env (one project).
# Never commit the real file. A STITCH_API_KEY exported in your shell takes precedence over both.

# Google Stitch API key: create one in your Stitch account settings (https://stitch.withgoogle.com).
STITCH_API_KEY=

# Optional: an account the loop signs in with for Playwright screenshots, if your design profile
# says to read them from here.
# DESIGN_LOOP_EMAIL=
# DESIGN_LOOP_PASSWORD=
